  "questions": [
    {
      "id": "q1",
      "text": "Mi foglalkoztat most a leginkább?",
      "help_text": "Válaszd azt, amelyik most a legjellemzőbb rád.",
      "input_type": "single",
      "required": true,
      "options": [
        {
          "id": "q1_o1",
          "text": "Folyamatosan feszült vagyok, nehezen kapcsolok ki.",
          "label_weights": { "content_a": 3, "readiness_low": 1 }
        },
        {
          "id": "q1_o2",
          "text": "A kapcsolataimban ismétlődő mintákat látok.",
          "label_weights": { "content_b": 3, "readiness_low": 1 }
        },
        {
          "id": "q1_o3",
          "text": "Mindkettő, és készen állok tenni ellene.",
          "label_weights": { "content_a": 2, "content_b": 2, "readiness_high": 2 }
        }
      ]
    },
    {
      "id": "q2",
      "text": "Mióta tart ez az érzés?",
      "input_type": "single",
      "required": true,
      "options": [
        {
          "id": "q2_o1",
          "text": "Néhány hete.",
          "label_weights": { "readiness_low": 1 }
        },
        {
          "id": "q2_o2",
          "text": "Több hónapja.",
          "label_weights": { "readiness_low": 2 }
        },
        {
          "id": "q2_o3",
          "text": "Több mint egy éve, és elegem van belőle.",
          "label_weights": { "readiness_high": 3 }
        }
      ]
    },
    {
      "id": "q3",
      "text": "Próbáltál már ez ügyben tenni valamit?",
      "input_type": "single",
      "required": true,
      "options": [
        {
          "id": "q3_o1",
          "text": "Még nem, csak most kezdek gondolkodni rajta.",
          "label_weights": { "readiness_low": 2 }
        },
        {
          "id": "q3_o2",
          "text": "Igen, olvastam róla, néztem videókat.",
          "label_weights": { "readiness_low": 1, "readiness_high": 1 }
        },
        {
          "id": "q3_o3",
          "text": "Igen, és keresek valakit, akivel dolgozhatnék rajta.",
          "label_weights": { "readiness_high": 3 }
        }
      ]
    },
    {
      "id": "q4",
      "text": "Melyik állítás igaz rád? (több is jelölhető)",
      "input_type": "multi",
      "required": true,
      "options": [
        {
          "id": "q4_o1",
          "text": "Nehezen mondok nemet másoknak.",
          "label_weights": { "content_b": 2 }
        },
        {
          "id": "q4_o2",
          "text": "Munkahelyi stressz nyomaszt.",
          "label_weights": { "content_a": 2 }
        },
        {
          "id": "q4_o3",
          "text": "Szeretnék proaktívan változtatni.",
          "label_weights": { "readiness_high": 1 }
        }
      ]
    }
  ],
